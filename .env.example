ANTHROPIC_API_KEY=sk-ant-...
DEEPGRAM_API_KEY=...
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=
WORKSPACE_DIR=/Users/yourname/code/current-project
CLAUDE_MODEL=claude-sonnet-4-5-20250929
DEBUG=false

# Optional: wake-word mode. Leave WAKE_WORD blank for always-listening.
