WAKE_WORD=
PORCUPINE_ACCESS_KEY=

# Optional: memory / history tuning
MAX_HISTORY_CHARS=200000
KEEP_LAST_N_TURNS=3
SUMMARIZER_MODEL=claude-haiku-4-5-20251001
